<?xml version="1.0" encoding="utf-8"?>
<!-- Atajos del ícono (mantener presionado): abren Cofre con una acción. MainActivity lee la acción. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="nuevo_gasto"
        android:enabled="true"
        android:icon="@drawable/ic_atajo_gasto"
        android:shortcutShortLabel="@string/atajo_gasto"
        android:shortcutLongLabel="@string/atajo_gasto_largo">
        <intent
            android:action="co.cofre.app.NUEVO_GASTO"
            android:targetPackage="co.cofre.app"
            android:targetClass="co.cofre.app.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="factura"
        android:enabled="true"
        android:icon="@drawable/ic_atajo_factura"
        android:shortcutShortLabel="@string/atajo_factura"
        android:shortcutLongLabel="@string/atajo_factura_largo">
        <intent
            android:action="co.cofre.app.FACTURA"
            android:targetPackage="co.cofre.app"
            android:targetClass="co.cofre.app.MainActivity" />
    </shortcut>
</shortcuts>
